# 站点 URL（上线改成 https://playcyoa.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEBSITE_NAME="PlayCYOA"

# ---- 视频生成 provider ----
# metaso | minimax | fal
VIDEO_PROVIDER=metaso

# 秘塔 MetaSo（首选，¥0.09/s，接口兼容 MiniMax 官方格式）
METASO_API_KEY=
METASO_BASE_URL=https://metaso.cn/api/minimax

# MiniMax 官方（备用，768P $0.08/s）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# fal H3 Max（备用，$0.04/s，最快）
FAL_KEY=
FAL_MODEL_ID=fal-ai/minimax/h3-max

# 全局每日新生成上限（防烧钱，0=不限制）
DAILY_GENERATION_LIMIT=30

# ---- 分支选项生成用的 LLM（可选，不配置则用内置兜底选项）----
# 任何 OpenAI 兼容接口都行：deepseek / openrouter / openai
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.deepseek.com
OPENAI_API_MODEL=deepseek-chat

# ---- Waffo Pancake（支付 + AIGC 提示词合规扫描）----
# 不配则跳过扫描（本地开发）；生产必须配置以通过 AIGC 审核
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENV=test
